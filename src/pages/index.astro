---
import '../styles/global.css';

const talents = [
  {
    number: '01',
    title: 'Uitleggen als een superkracht',
    text: 'Moeilijke dingen worden opeens logisch. En soms zelfs een beetje grappig.',
    color: 'sunny'
  },
  {
    number: '02',
    title: 'Iedereen laten groeien',
    text: 'Meester Joke ziet wat jij al kunt en helpt je ontdekken wat er nog meer in je zit.',
    color: 'sky'
  },
  {
    number: '03',
    title: 'De klas laten stralen',
    text: 'Met aandacht, geduld en een flinke dosis plezier voelt leren als een avontuur.',
    color: 'mint'
  }
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Een vrolijke ode aan meester Joke." />
    <title>Mijn meester is te goed voor deze wereld</title>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="page-title">
        <div class="hero__scribble" aria-hidden="true">✦</div>
        <nav class="topbar" aria-label="Hoofdnavigatie">
          <a class="brand" href="#top" aria-label="Naar boven">
            <span class="brand__dot"></span>
            <span>De klas van meester Joke</span>
          </a>
          <a class="topbar__link" href="#waarom">Waarom zo bijzonder? <span aria-hidden="true">↓</span></a>
        </nav>

        <div class="hero__content" id="top">
          <div class="hero__copy">
            <p class="eyebrow">Een kleine ode met een grote glimlach</p>
            <h1 id="page-title">Mijn meester is<br /><em>te goed</em> voor<br />deze wereld.</h1>
            <p class="hero__intro">Sommige meesters geven les. Meester Joke geeft je zin om morgen weer naar school te gaan.</p>
            <a class="button button--dark" href="#waarom">Ontdek waarom <span aria-hidden="true">↘</span></a>
          </div>
          <div class="hero__art" aria-label="Een getekende ster met een glimlach" role="img">
            <div class="sun-rays sun-rays--one"></div>
            <div class="sun-rays sun-rays--two"></div>
            <div class="star">★<span class="star__face">•‿•</span></div>
            <span class="doodle doodle--heart">♥</span>
            <span class="doodle doodle--sparkle">✦</span>
            <span class="doodle doodle--arrow">↗</span>
            <p class="art-note">hier woont<br />veel talent!</p>
          </div>
        </div>
        <div class="scroll-note"><span class="scroll-note__line"></span> scroll rustig verder</div>
      </section>

      <section class="statement" id="waarom" aria-labelledby="statement-title">
        <div class="section-label">01 <span>Het geheim</span></div>
        <div class="statement__content">
          <p class="eyebrow eyebrow--coral">Er zijn leraren...</p>
          <h2 id="statement-title">...en er zijn <span>meesters</span> die de wereld een stukje leuker maken.</h2>
          <p>Je merkt het aan de kleine dingen: een uitleg die blijft hangen, een grap op precies het goede moment en iemand die altijd in je gelooft.</p>
        </div>
        <div class="tape" aria-hidden="true">WAARSCHUWING: VEEL LIEFDE</div>
      </section>

      <section class="talents" aria-labelledby="talents-title">
        <div class="section-heading">
          <div class="section-label">02 <span>De meester-mix</span></div>
          <h2 id="talents-title">Superkrachten<br /><em>in het wild.</em></h2>
        </div>
        <div class="talent-grid">
          {talents.map((talent) => (
            <article class:list={['talent-card', `talent-card--${talent.color}`]}>
              <span class="talent-card__number">{talent.number}</span>
              <div class="talent-card__icon" aria-hidden="true">{talent.number === '01' ? '✎' : talent.number === '02' ? '↗' : '♥'}</div>
              <h3>{talent.title}</h3>
              <p>{talent.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <div class="closing__badge" aria-hidden="true">★<span>10/10<br />meester</span></div>
        <div class="section-label section-label--light">03 <span>De conclusie</span></div>
        <h2 id="closing-title">Dank je wel,<br /><em>meester Joke!</em></h2>
        <p>Voor elke glimlach, elk goed idee en elk moment waarop je ons liet voelen: dit kunnen wij.</p>
        <button class="button button--light" id="compliment-button" type="button">Geef een high five <span aria-hidden="true">✋</span></button>
        <p class="compliment" id="compliment" aria-live="polite"></p>
      </section>
    </main>
    <footer>Gemaakt met bewondering door de klas <span aria-hidden="true">✦</span></footer>

    <script>
      const button = document.querySelector('#compliment-button');
      const message = document.querySelector('#compliment');
      button?.addEventListener('click', () => {
        if (message) {
          message.textContent = 'High five gelukt! Meester Joke is officieel geweldig. ★';
        }
        button.textContent = 'Nog een high five! ✋';
      });
    </script>
  </body>
</html>
