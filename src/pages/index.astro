---
import { getEntry } from 'astro:content';
import '../styles/global.css';
import HeroSection from '../components/HeroSection.astro';
import StatementSection from '../components/StatementSection.astro';
import TalentGrid from '../components/TalentGrid.astro';
import ClosingSection from '../components/ClosingSection.astro';
import SiteFooter from '../components/SiteFooter.astro';

const homePage = await getEntry({ collection: 'pages', id: 'home' });

if (!homePage) {
  throw new Error('Home page content not found');
}

const content = homePage.data;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Een vrolijke ode aan meester Joke." />
    <title>{content.title}</title>
  </head>
  <body>
    <main>
      <HeroSection
        eyebrow={content.heroEyebrow}
        titleLine1={content.heroTitleLine1}
        titleEm={content.heroTitleEm}
        titleLine2={content.heroTitleLine2}
        titleLine3={content.heroTitleLine3}
        intro={content.heroIntro}
        primaryCta={content.primaryCta}
        primaryHref="#waarom"
        secondaryCta={content.secondaryCta}
        secondaryHref="/cadeau"
        secondaryLabel={content.secondCtaLabel}
      />

      <StatementSection
        sectionNumber="01"
        sectionLabel="Het geheim"
        eyebrow={content.statementEyebrow}
        highlight={content.statementHighlight}
        suffix={content.statementSuffix}
        text={content.statementText}
      />

      <TalentGrid talents={content.talents} />

      <ClosingSection
        sectionLabel="De conclusie"
        title={content.closingTitle}
        emphasis={content.closingEm}
        text={content.closingText}
      />
    </main>

    <SiteFooter text={content.footerText} />

    <script>
      const button = document.querySelector('#compliment-button');
      const message = document.querySelector('#compliment');
      button?.addEventListener('click', () => {
        if (message) {
          message.textContent = 'High five gelukt! Meester Joke is officieel geweldig. ★';
        }
        button.textContent = 'Nog een high five! ✋';
      });
    </script>
  </body>
</html>
