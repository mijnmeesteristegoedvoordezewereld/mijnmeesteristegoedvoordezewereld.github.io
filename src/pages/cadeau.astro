---
import { getEntry } from 'astro:content';
import '../styles/global.css';

const giftPage = await getEntry({ collection: 'pages', id: 'cadeau' });

if (!giftPage) {
  throw new Error('Gift page content not found');
}

const content = giftPage.data;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{content.title}</title>
  </head>
  <body>
    <div class="fireworks" aria-hidden="true">
      <span class="firework firework--1"></span>
      <span class="firework firework--2"></span>
      <span class="firework firework--3"></span>
      <span class="firework firework--4"></span>
      <span class="firework firework--5"></span>
      <span class="firework firework--6"></span>
      <span class="firework firework--7"></span>
      <span class="firework firework--8"></span>
    </div>

    <main class="gift-page">
      <section class="gift-card" aria-live="polite">
        <p class="eyebrow eyebrow--coral">Gefeliciteerd!</p>
        <h1>{content.headline}</h1>
        <p class="gift-message">{content.message}</p>
        <a class="button button--dark" href={content.backLink}>{content.buttonText} <span aria-hidden="true">↩</span></a>
      </section>
    </main>
  </body>
</html>
